<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.atlas.liquidity</groupId>
        <artifactId>atlas-liquidity-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>reference-data-service</artifactId>
    <name>Reference Data Service</name>
    <description>Legal entities, settlement accounts, currencies and jurisdictions</description>

    <dependencies>
        <dependency>
            <groupId>com.atlas.liquidity</groupId>
            <artifactId>liquidity-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- LAYER 2: persistence -->

        <!-- Spring Data JPA. Brings Hibernate, the JPA API, spring-tx and
             spring-jdbc (including HikariCP, the connection pool). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- The JDBC driver. runtime scope: our code never imports a Postgres
             class, it only needs the driver present when the app runs. Getting
             scopes right keeps compile-time coupling honest. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: versioned, ordered, checksummed schema migrations.
             Since Flyway 10, each database family lives in its own artifact -
             flyway-core alone will start and then fail with "Unsupported
             Database: PostgreSQL". Forgetting this second dependency is one of
             the most common Flyway upgrade problems. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Tests -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: starts a real Postgres in Docker for the duration
             of a test class. spring-boot-testcontainers adds @ServiceConnection,
             which wires the container's random port and credentials into the
             Spring context automatically - no @DynamicPropertySource boilerplate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              LAYER 2: Surefire runs UNIT tests (*Test) in the `test` phase.
              Failsafe runs INTEGRATION tests (*IT) in the `integration-test`
              phase, and - crucially - reports their failures in the `verify`
              phase rather than failing immediately. That ordering exists so
              that a `post-integration-test` step can always tear down whatever
              the tests started, even when they failed.

              The practical effect for you: `mvn test` is the fast loop and
              needs no Docker; `mvn verify` is the full loop and starts real
              containers. Being able to say why a project separates the two is
              a small but reliable signal of build-pipeline experience.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
