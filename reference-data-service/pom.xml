<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.atlas.liquidity</groupId>
        <artifactId>atlas-liquidity-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>reference-data-service</artifactId>
    <name>Reference Data Service</name>
    <description>Legal entities, settlement accounts, currencies and jurisdictions</description>

    <properties>
        <!--
          springdoc is NOT managed by the Spring Boot BOM, so we must pin a version
          ourselves - and it must match the Boot generation. springdoc 2.8.x targets
          Spring Boot 3.4/3.5; 2.7.x targets 3.3/3.4.

          If this version does not resolve, the error will be
          "Could not find artifact org.springdoc:springdoc-openapi-starter-webmvc-ui:jar:X".
          Pick a real one from https://central.sonatype.com/artifact/org.springdoc/springdoc-openapi-starter-webmvc-ui/versions
          and change this single line. Nothing else depends on the number.
        -->
        <springdoc.version>2.8.5</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.atlas.liquidity</groupId>
            <artifactId>liquidity-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          LAYER 3: OpenAPI. Brings springdoc, the swagger-annotations we use on the
          DTOs and controller, and the Swagger UI static resources. The document is
          generated from the real mappings at startup, so it cannot describe an
          endpoint that does not exist.

          Operational note for Layer 8: Swagger UI enumerates your whole attack
          surface in a friendly clickable form, so it belongs behind authentication
          or disabled outside non-production profiles.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          LAYER 4: Kafka.

          No version. spring-kafka IS managed by the Spring Boot BOM we imported
          in the root POM, unlike springdoc above - so Boot picks a spring-kafka
          that matches this Boot generation, and spring-kafka in turn pins a
          compatible kafka-clients. Letting the BOM choose is the whole reason
          for importing one.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- LAYER 2: persistence -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- runtime scope: our code never imports a Postgres class, it only needs
             the driver present when the app runs. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Since Flyway 10 each database family ships separately. flyway-core
             alone starts and then fails with "Unsupported Database: PostgreSQL". -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Tests -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers is still declared but currently unused: Docker Engine 29
             dropped the Engine API version its bundled docker-java requests, so the
             integration tests point at the Compose Postgres instead. See
             AbstractPostgresIntegrationTest for the full story and how to restore it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Surefire runs UNIT tests (*Test) in the `test` phase; Failsafe runs
              INTEGRATION tests (*IT) in `integration-test` and reports their
              failures in `verify`. So `mvn test` is the fast loop and `mvn verify`
              is the full one.

              classesDirectory is the important line. Failsafe runs AFTER `package`,
              and by then spring-boot:repackage has replaced the main artifact with a
              fat jar whose classes live under BOOT-INF/classes/ - invisible to a
              standard classpath, because a JAR cannot contain another JAR on one.
              Without this, test discovery dies with ClassNotFoundException on our
              own classes. Surefire is unaffected because it runs before `package`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
