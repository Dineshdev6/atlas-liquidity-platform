<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.atlas.liquidity</groupId>
        <artifactId>atlas-liquidity-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>position-service</artifactId>
    <name>Position Service</name>
    <description>Maintains intraday cash positions from the event stream</description>

    <properties>
        <confluent.version>7.7.1</confluent.version>
    </properties>

    <!--
      THE SECOND SERVICE, AND WHY IT IS A SEPARATE MODULE

      Note what this POM does NOT depend on: reference-data-service. There is no
      compile-time link between them at all, and there is no shared database.
      Everything this service knows, it learned from a Kafka topic.

      That is the actual test of whether something is a microservice. Two modules
      that call each other synchronously and read each other's tables are one
      application in two jars, with all the deployment pain and none of the
      independence. These two can be deployed separately, scaled separately, and
      one can be down for an hour without stopping the other - which you will
      demonstrate rather than assert.

      The one thing they do share is liquidity-common, for the event definition.
      That coupling is real and named in LiquidityBufferChangedEvent's javadoc:
      a shared jar means a breaking change to the event needs a coordinated
      release, which is exactly what event-driven architecture is meant to avoid.
      Part 3 replaces it with a schema registry, where the contract lives
      independently of anyone's code.
    -->


    <!--
      CONFLUENT'S ARTEFACTS ARE NOT ON MAVEN CENTRAL.

      kafka-avro-serializer and the schema-registry client are published only to
      Confluent's own repository, so Maven has to be told about it explicitly.
      This is a genuine operational detail rather than trivia: in a bank your
      build talks to an internal Nexus or Artifactory that proxies Central, and
      "the Confluent repo has not been mirrored yet" is a real ticket someone
      raises on their first day.

      Declared per-module rather than in the root POM only because the root POM
      carries local edits we do not want to overwrite; a repository declaration
      belongs in the parent in a real project - or better, in settings.xml, so
      that switching to an internal mirror does not require touching every POM.
    -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent</name>
            <url>https://packages.confluent.io/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.atlas.liquidity</groupId>
            <artifactId>liquidity-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
          LAYER 4 PART 3: Avro over the wire, with the schema registry.

          This one artefact brings KafkaAvroSerializer/Deserializer and the
          registry client, and transitively the Avro runtime. Version 7.7.x is a
          Confluent Platform version, not a Kafka version - Confluent 7.7 tracks
          Kafka 3.7, and the serialisers are perfectly happy against the 3.9
          broker we run, because they only speak the ordinary producer/consumer
          protocol plus HTTP to the registry.
        -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
        </dependency>


        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Same classesDirectory override as reference-data-service, for the
              same reason: Failsafe runs after `package`, by which point
              spring-boot:repackage has replaced the artifact with a fat jar whose
              classes live under BOOT-INF/classes/ and are invisible to a standard
              classpath. Without this line, test discovery dies with
              ClassNotFoundException on our own classes. Surefire is unaffected
              because it runs before `package`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
