<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.atlas.liquidity</groupId>
        <artifactId>atlas-liquidity-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>liquidity-common</artifactId>
    <name>Liquidity Common</name>
    <description>Shared domain primitives, error model and cross-cutting web concerns</description>

    <!--
      TEACHING NOTE
      This module is a plain library, NOT a Spring Boot application.
      It has no main class and no spring-boot-maven-plugin, so it produces a
      normal thin JAR that other modules can depend on. If you accidentally add
      the boot plugin here, it repackages the jar into an executable fat jar and
      downstream modules can no longer see its classes - a classic and very
      confusing multi-module mistake.
    -->

    <properties>
        <!--
          Avro is NOT managed by the Spring Boot BOM, so we pin it - and the
          version has to agree with the one Confluent's serialisers were built
          against, or generated code and runtime disagree in ways that surface as
          NoSuchMethodError rather than anything helpful. Confluent 7.7.x ships
          Avro 1.11.3.
        -->
        <avro.version>1.11.3</avro.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          LAYER 4 PART 3: the Avro runtime. The generated classes below extend
          SpecificRecordBase from this jar, so it is a compile dependency of every
          module that touches an event.
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>

        <!-- provided: the servlet container supplies this at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              CODE GENERATION FROM THE SCHEMA, and the direction matters.

              The .avsc file is the source of truth; the Java class is an output,
              regenerated on every build into target/generated-sources. Nobody
              edits it, nobody commits it. The alternative - write the Java class
              and derive a schema from it - looks more convenient and quietly makes
              your wire contract a side effect of a refactor, which is how a field
              rename becomes an outage.

              stringType=String is the one setting people regret leaving out.
              Without it Avro generates CharSequence fields holding its own Utf8
              type, so every comparison, every map key and every log line needs a
              toString() and equals() silently returns false against a String.
            -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>generate-event-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                            <fieldVisibility>PRIVATE</fieldVisibility>
                            <createSetters>false</createSetters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
